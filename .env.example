# Read-only Postgres connection for the tracker.
# Use a DB role that can ONLY SELECT from orders, order_items and settings (see README).

# Option A: a single connection string
# DATABASE_URL=postgres://stockflow_tracker:CHANGE_ME@your-db-host:5432/defaultdb

# Option B: discrete variables
DB_HOST=your-db-host
DB_PORT=5432
DB_USER=stockflow_tracker
DB_PASSWORD=CHANGE_ME
DB_NAME=defaultdb

# Set to "false" only for a local non-SSL Postgres.
DB_SSL=true

PORT=4000
